package-as: AdventForever

# Kept in the repository, left out of the download.
ignore:
  - docs
  - .github
  - .gitignore
  - .gitattributes
  - .pkgmeta
  - README.md

# Release notes (GitHub, Wago, WowUp) come from our own changelog, not the commit list.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
